# Generated by scripts/vendor-ui.mjs from the @bb registry pinned in
# vendor-ui.json. They are byte-identical to bb's own packages/shared-ui, so
# they cannot carry a generated banner of their own — the directory says it
# instead, and npm run check:ui fails on any hand-edit or stray file in there.
# eol=lf as well as generated: the lock digests bytes, so a CRLF checkout would
# fail check:ui on every one of these.
plugins/*/src/vendor/** linguist-generated=true eol=lf
plugins/*/src/icon-catalog.generated.ts linguist-generated=true
vendor-ui.lock.json linguist-generated=true
