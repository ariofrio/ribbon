# Generated by scripts/vendor-ui.mjs from the @bb registry pinned in
# vendor-ui.json. They are byte-identical to bb's own packages/shared-ui, so
# they cannot carry a generated banner of their own — this marks them instead,
# and npm run check:ui fails on any hand-edit.
plugins/*/src/components/ui/** linguist-generated=true
plugins/*/src/lib/portal-scope.ts linguist-generated=true
plugins/*/src/lib/utils.ts linguist-generated=true
plugins/*/src/hooks/useBrowserDimmingModal.ts linguist-generated=true
plugins/*/src/icon-catalog.generated.ts linguist-generated=true
vendor-ui.lock.json linguist-generated=true

# Plugin-owned files that live inside a vendored directory.
plugins/bb-plugin-thread-stages/src/components/ui/tooltip.test.tsx -linguist-generated
plugins/bb-plugin-thread-stages/src/lib/dialog-position.ts -linguist-generated
