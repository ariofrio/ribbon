    "typecheck": "tsc --noEmit",
    "verify:lockfile": "npm ci --workspaces=false --ignore-scripts --dry-run --no-audit --no-fund --loglevel=error",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "verify:styles": "node ../../scripts/verify-styles.mjs",
    "verify:types": "node ../../scripts/verify-types.mjs"
  },
  "engines": {
    "bb": ">=0.42.1",
