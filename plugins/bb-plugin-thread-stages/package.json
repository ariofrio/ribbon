{
  "name": "bb-plugin-thread-stages",
  "version": "2.1.0",
  "description": "bb's thread list with workflow stages, stable thread order, and section and project icons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariofrio/ribbon.git",
    "directory": "plugins/bb-plugin-thread-stages"
  },
  "homepage": "https://github.com/ariofrio/ribbon/tree/main/plugins/bb-plugin-thread-stages#readme",
  "bugs": {
    "url": "https://github.com/ariofrio/ribbon/issues"
  },
  "files": [
    "assets",
    "!assets/screenshot*.png",
    "!assets/card*.png",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "skills",
    "!skills/**/__pycache__/**",
    "!skills/**/*_test.py"
  ],
  "type": "module",
  "scripts": {
    "build": "bb plugin build",
    "build:catalog": "node scripts/build-icon-catalog.mjs",
    "check:catalog": "node scripts/build-icon-catalog.mjs --check",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run verify:lockfile && npm run check:evals && npm test && npm run typecheck && npm run verify:types && npm run build && npm run verify:styles && npm run verify:package",
    "check:evals": "python3 skills/thread-stages/evals/evals_test.py",
    "evals": "python3 skills/thread-stages/evals/run.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "npm ci --workspaces=false --ignore-scripts --dry-run --no-audit --no-fund --loglevel=error",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "verify:styles": "node ../../scripts/verify-styles.mjs",
    "verify:types": "node ../../scripts/verify-types.mjs"
  },
  "engines": {
    "bb": ">=0.45.0",
    "bbPluginSdk": "^0.6.15"
  },
  "bb": {
    "name": "Thread stages",
    "description": "bb's thread list with workflow stages, stable thread order, and section and project icons.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/plugin-server.ts",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-compose-refs": "^1.1.3",
    "@radix-ui/react-slot": "^1.3.3",
    "jotai": "^2.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.45.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.0.0"
  }
}
