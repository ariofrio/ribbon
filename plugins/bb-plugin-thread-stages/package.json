  },
  "bb": {
    "name": "Thread stages",
    "description": "Provide workflow stages, automation, and shortcuts to Ribbon sidebar.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
