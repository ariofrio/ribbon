{
  "name": "bb-plugin-thread-stages",
  "version": "0.7.0",
  "description": "Group threads in the sidebar into stages from Deferred to Completed, updating as they run.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariofrio/ribbon.git",
    "directory": "plugins/bb-plugin-thread-stages"
  },
  "homepage": "https://github.com/ariofrio/ribbon/tree/main/plugins/bb-plugin-thread-stages#readme",
  "bugs": {
    "url": "https://github.com/ariofrio/ribbon/issues"
  },
  "files": [
    "assets",
    "!assets/screenshot*.png",
    "!assets/card*.png",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "scripts",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "build": "bb plugin build",
    "prepublishOnly": "npm run release:check",
    "qa:menu-animations": "bash scripts/qa-menu-animations.sh",
    "qa:project-filter-hover": "bash scripts/qa-project-filter-hover.sh",
    "qa:sidebar-indicator-alignment": "bash scripts/qa-sidebar-indicator-alignment.sh",
    "qa:thread-row-height": "bash scripts/qa-thread-row-height.sh",
    "release:check": "npm run verify:lockfile && npm test && npm run typecheck && npm run verify:types && npm run build && npm run verify:styles && npm run verify:package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "npm ci --workspaces=false --ignore-scripts --dry-run --no-audit --no-fund --loglevel=error",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "verify:styles": "node ../../scripts/verify-styles.mjs",
    "verify:types": "node ../../scripts/verify-types.mjs"
  },
  "engines": {
    "bb": ">=0.36",
    "bbPluginSdk": "^0.4.8"
  },
  "bb": {
    "name": "Thread stages",
    "description": "Group threads in the sidebar into stages from Deferred to Completed, updating as they run.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.39.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
