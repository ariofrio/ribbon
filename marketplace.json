{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "ribbon",
  "displayName": "Ribbon",
  "description": "A suite of bb plugins for managing large amounts of agents.",
  "plugins": [
    {
      "id": "breadcrumbs",
      "displayName": "Breadcrumbs",
      "description": "Show a thread's section, project, and ancestors in its header.",
      "icon": {
        "url": "./plugins/bb-plugin-breadcrumbs/assets/icon.svg"
      },
      "tags": [
        "interface",
        "projects",
        "navigation",
        "threads"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-breadcrumbs",
          "range": "*",
          "tagPrefix": "breadcrumbs/"
        }
      }
    },
    {
      "id": "chatgpt-theme",
      "displayName": "ChatGPT theme",
      "description": "Restyle bb to match the OpenAI ChatGPT (Codex) desktop app.",
      "icon": {
        "url": "./plugins/bb-plugin-chatgpt-theme/assets/icon.svg"
      },
      "tags": [
        "theme",
        "appearance",
        "light",
        "dark",
        "chatgpt",
        "codex"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-chatgpt-theme",
          "range": "*",
          "tagPrefix": "chatgpt-theme/"
        }
      }
    },
    {
      "id": "icons",
      "displayName": "Icons",
      "description": "Give each section and project an icon and color.",
      "icon": {
        "url": "./plugins/bb-plugin-icons/assets/icon.svg"
      },
      "tags": [
        "projects",
        "icons",
        "colors",
        "interface",
        "sidebar"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-icons",
          "range": "*",
          "tagPrefix": "icons/"
        }
      }
    },
    {
      "id": "missing-keyboard-shortcuts",
      "displayName": "Missing keyboard shortcuts",
      "description": "Add shortcuts to start personal or project threads, navigate history, and reach the composer or panel tabs.",
      "icon": {
        "url": "./plugins/bb-plugin-missing-keyboard-shortcuts/assets/icon.svg"
      },
      "tags": [
        "keyboard-shortcuts",
        "navigation",
        "threads",
        "interface",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-missing-keyboard-shortcuts",
          "range": "*",
          "tagPrefix": "missing-keyboard-shortcuts/"
        }
      }
    },
    {
      "id": "ribbon-sidebar",
      "displayName": "Ribbon sidebar",
      "description": "Organize threads by projects, sections, and provider-defined groupings in one sidebar.",
      "icon": {
        "url": "./plugins/bb-plugin-ribbon-sidebar/assets/icon.svg"
      },
      "tags": [
        "sidebar",
        "threads",
        "projects",
        "sections",
        "productivity",
        "cli"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-ribbon-sidebar",
          "range": "*",
          "tagPrefix": "ribbon-sidebar/"
        }
      }
    },
    {
      "id": "thread-stages",
      "displayName": "Thread stages",
      "description": "Provide workflow stages, automation, and shortcuts to Ribbon sidebar.",
      "icon": {
        "url": "./plugins/bb-plugin-thread-stages/assets/icon.svg"
      },
      "tags": [
        "stages",
        "sidebar",
        "threads",
        "productivity",
        "keyboard-shortcuts",
        "cli"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-thread-stages",
          "range": "*",
          "tagPrefix": "thread-stages/"
        }
      }
    }
  ]
}
