{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "ribbon",
  "displayName": "Ribbon",
  "description": "A suite of bb plugins for managing large amounts of agents.",
  "plugins": [
    {
      "id": "chatgpt-theme",
      "displayName": "ChatGPT theme",
      "description": "Restyle bb to match the OpenAI ChatGPT (Codex) desktop app.",
      "icon": {
        "url": "./plugins/bb-plugin-chatgpt-theme/assets/icon.svg"
      },
      "tags": [
        "theme",
        "appearance",
        "light",
        "dark",
        "chatgpt",
        "codex"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-chatgpt-theme",
          "range": "*",
          "tagPrefix": "chatgpt-theme/"
        }
      }
    },
    {
      "id": "missing-keyboard-shortcuts",
      "displayName": "Missing keyboard shortcuts",
      "description": "Add shortcuts to start personal or project threads, navigate history, and reach the composer or panel tabs.",
      "icon": {
        "url": "./plugins/bb-plugin-missing-keyboard-shortcuts/assets/icon.svg"
      },
      "tags": [
        "keyboard-shortcuts",
        "navigation",
        "threads",
        "interface",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-missing-keyboard-shortcuts",
          "range": "*",
          "tagPrefix": "missing-keyboard-shortcuts/"
        }
      }
    },
    {
      "id": "model-mentions",
      "displayName": "Model mentions",
      "description": "Mention models and providers in task instructions using live provider catalogs.",
      "icon": {
        "url": "./plugins/bb-plugin-model-mentions/assets/icon.svg"
      },
      "tags": [
        "models",
        "mentions",
        "providers",
        "threads",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-model-mentions",
          "range": "*",
          "tagPrefix": "model-mentions/"
        }
      }
    },
    {
      "id": "thread-stages",
      "displayName": "Thread stages",
      "description": "bb's thread list with workflow stages, stable thread order, and section and project icons.",
      "icon": {
        "url": "./plugins/bb-plugin-thread-stages/assets/icon.svg"
      },
      "tags": [
        "stages",
        "sidebar",
        "threads",
        "productivity",
        "keyboard-shortcuts",
        "cli"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-thread-stages",
          "range": "*",
          "tagPrefix": "thread-stages/"
        }
      }
    },
    {
      "id": "thread-titles",
      "displayName": "Thread titles",
      "description": "Title threads from their first message and first turn, and refine generic, inaccurate, or overlong titles on the third user message.",
      "icon": {
        "url": "./plugins/bb-plugin-thread-titles/assets/icon.svg"
      },
      "tags": [
        "threads",
        "automation",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-thread-titles",
          "range": "*",
          "tagPrefix": "thread-titles/"
        }
      }
    },
    {
      "id": "default-sections",
      "displayName": "Default sections",
      "description": "Give each project a default section, so its new threads start there.",
      "icon": {
        "url": "./plugins/bb-plugin-default-sections/assets/icon.svg"
      },
      "tags": [
        "threads",
        "sections",
        "organization",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/ribbon.git",
          "subdir": "plugins/bb-plugin-default-sections",
          "range": "*",
          "tagPrefix": "default-sections/"
        }
      }
    }
  ]
}
