{
  "name": "ribbon",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "plugins/*",
    "scripts/screenshots"
  ],
  "scripts": {
    "build:heading-icons": "node scripts/heading-icons.mjs",
    "build:ui": "node scripts/vendor-ui.mjs",
    "changeset": "changeset",
    "check:heading-icons": "node scripts/heading-icons.mjs --check",
    "check:layout": "node scripts/plugin-layout.mjs",
    "check:ui": "node scripts/vendor-ui.mjs --check",
    "install:plugins": "node scripts/install-plugins.mjs",
    "prepare": "git config --local core.hooksPath .githooks || true",
    "screenshots": "node scripts/require-node.mjs && node scripts/screenshots/run.mjs",
    "test": "node --test scripts/*.test.mjs scripts/screenshots/*.test.mjs",
    "test:e2e": "node scripts/require-node.mjs && node scripts/e2e/run.mjs",
    "version:plugins": "changeset version && node scripts/sync-plugin-lockfiles.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "playwright": "^1.62.1",
    "semver": "^7.8.1"
  }
}
