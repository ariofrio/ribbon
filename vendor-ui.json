{
  "$comment": "Single source of truth for the bb UI components each plugin vendors. scripts/vendor-ui.mjs owns plugins/*/src/vendor/ outright and is its only writer; a hand-edit, or any file in there no closure explains, fails npm run check:ui. Compose around a component instead of editing it — bb exports the seams (CompactViewportOverrideProvider, ResponsiveDrawerShell, MobileTrigger, stripRadixContentProps, MENU_ITEM_LAST_HOVERED_CLASS, LIST_HOVER_TRANSITION).",
  "registry": "https://raw.githubusercontent.com/get-bb/bb/desktop-v0.44.0/packages/plugin-registry/r/{name}.json",
  "plugins": {
    "plugins/bb-plugin-breadcrumbs": [
      "button",
      "dialog",
      "drawer",
      "dropdown-menu",
      "input"
    ],
    "plugins/bb-plugin-icons": [
      "drawer",
      "icon",
      "input",
      "popover",
      "tooltip"
    ],
    "plugins/bb-plugin-ribbon-sidebar": [
      "button",
      "checkbox",
      "context-menu",
      "dialog",
      "dropdown-menu",
      "input",
      "textarea",
      "tooltip"
    ],
    "plugins/bb-plugin-thread-stages": {
      "root": "",
      "items": [
        "button",
        "checkbox",
        "chrome-style-tokens",
        "coarse-pointer-sizing",
        "context-menu",
        "dialog",
        "dropdown-menu",
        "empty-state",
        "icon",
        "input",
        "motion",
        "popover",
        "skeleton",
        "textarea",
        "tooltip",
        "use-compact-viewport",
        "use-pointer-coarse",
        "utils"
      ]
    },
    "plugins/bb-plugin-thread-titles": [
      "button"
    ]
  },
  "literals": [
    {
      "file": "plugins/bb-plugin-ribbon-sidebar/src/chrome-style-tokens.ts",
      "symbol": "CHROME_SECTION_LABEL_CLASS",
      "upstream": "packages/shared-ui/src/components/ui/chrome-style-tokens.ts",
      "why": "one constant out of a shared-ui file the registry does not publish"
    },
    {
      "file": "plugins/bb-plugin-ribbon-sidebar/src/thread-actions-menu.tsx",
      "symbol": "DESTRUCTIVE_CONTEXT_ITEM_CLASS",
      "upstream": "apps/app/src/components/ui/action-menu-items.tsx",
      "why": "bb gives ContextMenuItem no destructive variant and styles its own by className"
    }
  ]
}
